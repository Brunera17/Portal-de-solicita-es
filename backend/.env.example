# Porta HTTP da API
PORT=3333

# Conexão com o PostgreSQL
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_solicitacoes?schema=public"

# Banco EXCLUSIVO para os testes de API (npm test): ele é apagado e recriado a cada execução
TEST_DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_teste?schema=public"

# Autenticação (troque o segredo em produção)
JWT_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"

# Origem permitida pelo CORS (endereço do frontend)
CORS_ORIGIN="http://localhost:5173"

# Quantidade de proxies reversos à frente da API (0 em desenvolvimento; 1 atrás do Nginx no Docker)
TRUST_PROXY=0
