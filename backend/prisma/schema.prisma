generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Hierarquia: SOLICITANTE < ATENDENTE < GERENTE
enum Perfil {
  SOLICITANTE
  ATENDENTE
  GERENTE

  @@map("perfil_usuario")
}

enum StatusSolicitacao {
  ABERTO
  EM_ATENDIMENTO
  CONCLUIDO

  @@map("status_solicitacao")
}

enum TipoNotificacao {
  STATUS_ALTERADO
  NOVO_COMENTARIO

  @@map("tipo_notificacao")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(100)
  usuario      String   @unique @db.VarChar(50)
  senhaHash    String   @map("senha_hash") @db.VarChar(255)
  perfil       Perfil   @default(SOLICITANTE)
  corAvatar    String   @default("indigo") @map("cor_avatar") @db.VarChar(20)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  solicitacoes        Solicitacao[]     @relation("Solicitante")
  atendimentos        Solicitacao[]     @relation("Responsavel")
  alteracoesStatus    HistoricoStatus[]
  comentarios         Comentario[]
  notificacoes        Notificacao[]     @relation("Destinatario")
  notificacoesGeradas Notificacao[]     @relation("AutorNotificacao")

  @@map("usuarios")
}

/// Categorias administradas pelo gerente. Categorias em uso não são excluídas, apenas desativadas.
model Categoria {
  id       Int      @id @default(autoincrement())
  nome     String   @unique @db.VarChar(50)
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  solicitacoes Solicitacao[]

  @@map("categorias")
}

model Solicitacao {
  id            Int               @id @default(autoincrement())
  titulo        String            @db.VarChar(150)
  descricao     String            @db.Text
  categoriaId   Int               @map("categoria_id")
  status        StatusSolicitacao @default(ABERTO)
  solicitanteId Int               @map("solicitante_id")
  /// Quem iniciou o atendimento (definido ao passar para EM_ATENDIMENTO)
  responsavelId Int?              @map("responsavel_id")
  criadoEm      DateTime          @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  categoria    Categoria         @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  solicitante  Usuario           @relation("Solicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  responsavel  Usuario?          @relation("Responsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  historico    HistoricoStatus[]
  comentarios  Comentario[]
  notificacoes Notificacao[]

  @@index([status])
  @@index([responsavelId, status])
  @@index([categoriaId])
  @@index([criadoEm])
  @@index([solicitanteId])
  @@map("solicitacoes")
}

model HistoricoStatus {
  id             Int                @id @default(autoincrement())
  solicitacaoId  Int                @map("solicitacao_id")
  statusAnterior StatusSolicitacao? @map("status_anterior")
  statusNovo     StatusSolicitacao  @map("status_novo")
  alteradoPorId  Int                @map("alterado_por_id")
  alteradoEm     DateTime           @default(now()) @map("alterado_em") @db.Timestamptz(3)

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  alteradoPor Usuario     @relation(fields: [alteradoPorId], references: [id], onDelete: Restrict)

  @@index([solicitacaoId])
  @@map("historico_status")
}

/// Comentários são imutáveis (trilha de auditoria). Comentários internos só são visíveis à equipe.
model Comentario {
  id            Int      @id @default(autoincrement())
  solicitacaoId Int      @map("solicitacao_id")
  autorId       Int      @map("autor_id")
  texto         String   @db.Text
  interno       Boolean  @default(false)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  autor       Usuario     @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@index([solicitacaoId, criadoEm])
  @@map("comentarios")
}

/// Avisos para o usuário (sino). Gerados pelo backend quando o status muda ou chega comentário.
model Notificacao {
  id             Int             @id @default(autoincrement())
  destinatarioId Int             @map("destinatario_id")
  autorId        Int             @map("autor_id")
  solicitacaoId  Int             @map("solicitacao_id")
  tipo           TipoNotificacao
  mensagem       String          @db.VarChar(300)
  lida           Boolean         @default(false)
  criadoEm       DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)

  destinatario Usuario     @relation("Destinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  autor        Usuario     @relation("AutorNotificacao", fields: [autorId], references: [id], onDelete: Cascade)
  solicitacao  Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@index([destinatarioId, lida, criadoEm])
  @@map("notificacoes")
}
