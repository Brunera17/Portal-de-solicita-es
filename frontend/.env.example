# URL base da API usada pelo navegador.
# Padrão "/api": em desenvolvimento o Vite repassa para o backend (ver API_PROXY_TARGET);
# no Docker, o Nginx faz o mesmo papel.
VITE_API_URL=/api

# Endereço do backend para o proxy do servidor de desenvolvimento (npm run dev)
API_PROXY_TARGET=http://localhost:3333

# Exibe na tela de login o painel com os usuários de demonstração (desligar em produção)
VITE_EXIBIR_USUARIOS_DEMO=true
